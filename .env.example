# Multi-Agent Trading Floor — configuration
#
# Every variable is optional; the defaults run a complete, self-contained
# paper session with no external services.
#
# THERE IS NO SETTING THAT ENABLES LIVE TRADING. Paper mode is a property of
# the build, not a flag: this codebase contains no exchange order-submission
# implementation. See "Paper mode security boundary" in the README.

# --- runtime -----------------------------------------------------------------
TF_ENVIRONMENT=local
TF_LOG_LEVEL=INFO
TF_LOG_FORMAT=json          # json | text

# --- market data -------------------------------------------------------------
# simulated : deterministic synthetic market, fully offline (default)
# live      : public, read-only exchange WebSocket feeds
TF_FEED=simulated
TF_SYMBOLS=["BTC-USD","ETH-USD"]

# --- paper account -----------------------------------------------------------
TF_PAPER_INITIAL_BALANCE=100000

# --- strategy ----------------------------------------------------------------
# Minimum gross cross-venue dislocation, in bps, before an opportunity is even
# considered. ZEPHR then decides whether it survives execution costs.
TF_MIN_DISLOCATION_BPS=4.0
TF_TICK_INTERVAL_S=0.25

# --- event bus ---------------------------------------------------------------
# memory : in-process (default; deterministic, used by every test)
# redis  : Redis Streams
TF_BUS=memory
TF_REDIS_URL=redis://localhost:6379/0

# --- storage -----------------------------------------------------------------
# sqlite | postgres | memory
TF_STORAGE_BACKEND=sqlite
TF_SQLITE_PATH=./data/trading_floor.db
TF_POSTGRES_DSN=postgresql://trading:trading@localhost:5432/trading_floor
# Persist raw venue payloads alongside normalised events. High volume; useful
# when a normalisation bug has to be reproduced from the wire.
TF_RECORD_RAW=true

# --- intelligence layer (LUMEN and RUNE-AI) ----------------------------------
# null     : no intelligence provider (default). The platform is fully
#            functional without one; LUMEN simply publishes no opinion.
# claude   : Claude via the Anthropic API
# scripted : deterministic canned responses, for tests
TF_INTELLIGENCE_PROVIDER=null
TF_CLAUDE_MODEL=claude-opus-5
TF_LUMEN_POLL_INTERVAL_S=30

# Read by the Anthropic SDK when TF_INTELLIGENCE_PROVIDER=claude.
# Claude never sees orders, balances, credentials, risk limits or position
# sizing — only structured market context and headlines.
# ANTHROPIC_API_KEY=

# --- dashboard / API ---------------------------------------------------------
TF_API_HOST=0.0.0.0
TF_API_PORT=8080
